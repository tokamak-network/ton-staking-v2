package verification

import (
	"context"
	"fmt"
	"math/big"

	"github.com/ethereum/go-ethereum"
	"github.com/ethereum/go-ethereum/common"
	"github.com/ethereum/go-ethereum/core/types"
	"github.com/ethereum/go-ethereum/ethclient"
)

// L1DataVerifier verifies L1 data consistency (NO L2 RPC)
// Approach:
// 1. Fetch batch data from L1 (batcher tx)
// 2. Fetch claimed output root from L1 DisputeGame
// 3. Verify both are on L1 and point to same L2 block
//
// This is FULLY TRUSTLESS using only L1 data!
type L1DataVerifier struct {
	l1Client            *ethclient.Client
	disputeGameFactory  common.Address
	batchInbox          common.Address
	batcherAddress      common.Address
}

// NewL1DataVerifier creates a new L1-only data verifier
func NewL1DataVerifier(
	l1RPCURL string,
	disputeGameFactory common.Address,
	batchInbox common.Address,
	batcherAddress common.Address,
) (*L1DataVerifier, error) {
	client, err := ethclient.Dial(l1RPCURL)
	if err != nil {
		return nil, fmt.Errorf("failed to connect to L1: %w", err)
	}

	return &L1DataVerifier{
		l1Client:           client,
		disputeGameFactory: disputeGameFactory,
		batchInbox:         batchInbox,
		batcherAddress:     batcherAddress,
	}, nil
}

// L1VerificationEvidence contains L1-only evidence
type L1VerificationEvidence struct {
	// Batch data from L1
	BatchL1BlockNumber uint64
	BatchL1TxHash      common.Hash
	BatchL1TxIndex     uint
	BatchData          []byte
	BatchTxProof       [][]byte // Merkle proof that batch tx is in L1 block

	// DisputeGame data from L1
	DisputeGameAddress  common.Address
	ClaimedOutputRoot   common.Hash
	ClaimedL2BlockNumber uint64
	DisputeGameL1Block  uint64
	DisputeGameL1TxHash common.Hash

	// Consistency checks
	BatchTimestamp  uint64
	ExpectedL2Block uint64 // Derived from batch
}

// VerifyL1DataConsistency verifies L1 batch data matches DisputeGame claim
// WITHOUT using L2 RPC at all
func (v *L1DataVerifier) VerifyL1DataConsistency(
	ctx context.Context,
	batchIndex uint32,
	disputeGameAddress common.Address,
) (*L1VerificationEvidence, error) {
	evidence := &L1VerificationEvidence{
		DisputeGameAddress: disputeGameAddress,
	}

	// Step 1: Get DisputeGame data from L1
	gameData, err := v.getDisputeGameData(ctx, disputeGameAddress)
	if err != nil {
		return nil, fmt.Errorf("failed to get dispute game data: %w", err)
	}

	evidence.ClaimedOutputRoot = gameData.OutputRoot
	evidence.ClaimedL2BlockNumber = gameData.L2BlockNumber
	evidence.DisputeGameL1Block = gameData.L1BlockNumber
	evidence.DisputeGameL1TxHash = gameData.L1TxHash

	// Step 2: Get batch data from L1
	batchData, err := v.getBatchDataFromL1(ctx, batchIndex)
	if err != nil {
		return nil, fmt.Errorf("failed to get batch data: %w", err)
	}

	evidence.BatchL1BlockNumber = batchData.L1BlockNumber
	evidence.BatchL1TxHash = batchData.L1TxHash
	evidence.BatchL1TxIndex = batchData.TxIndex
	evidence.BatchData = batchData.Data
	evidence.BatchTimestamp = batchData.Timestamp

	// Step 3: Generate Merkle proof for batch tx
	batchTxProof, err := v.generateBatchTxProof(ctx, batchData.L1BlockNumber, batchData.TxIndex)
	if err != nil {
		return nil, fmt.Errorf("failed to generate batch tx proof: %w", err)
	}
	evidence.BatchTxProof = batchTxProof

	// Step 4: Verify consistency
	// The batch and dispute game should point to the same L2 block
	// We can check:
	// - Batch timestamp matches expected L2 block time
	// - L2 block number is consistent with batch sequence

	// Derive expected L2 block number from batch
	// TODO: This requires knowing the L2 block time and genesis timestamp
	// For now, just record what we found
	evidence.ExpectedL2Block = gameData.L2BlockNumber // Placeholder

	// Consistency check: Are they pointing to the same L2 block?
	if evidence.ExpectedL2Block != evidence.ClaimedL2BlockNumber {
		return evidence, fmt.Errorf(
			"L2 block number mismatch: batch expects %d, game claims %d",
			evidence.ExpectedL2Block,
			evidence.ClaimedL2BlockNumber,
		)
	}

	return evidence, nil
}

// DisputeGameData represents data fetched from DisputeGame contract on L1
type DisputeGameData struct {
	OutputRoot    common.Hash
	L2BlockNumber uint64
	L1BlockNumber uint64 // L1 block where game was created
	L1TxHash      common.Hash
	Timestamp     uint64
}

// getDisputeGameData fetches dispute game data from L1
func (v *L1DataVerifier) getDisputeGameData(
	ctx context.Context,
	gameAddress common.Address,
) (*DisputeGameData, error) {
	gameData := &DisputeGameData{}

	// Call DisputeGame.rootClaim() to get claimed output root
	// Function selector: keccak256("rootClaim()") = 0xbcef3b55...
	rootClaimData := common.Hex2Bytes("bcef3b55")
	rootClaimResult, err := v.l1Client.CallContract(ctx, ethereum.CallMsg{
		To:   &gameAddress,
		Data: rootClaimData,
	}, nil)
	if err != nil {
		return nil, fmt.Errorf("failed to call rootClaim(): %w", err)
	}
	if len(rootClaimResult) != 32 {
		return nil, fmt.Errorf("invalid rootClaim result length: %d", len(rootClaimResult))
	}
	gameData.OutputRoot = common.BytesToHash(rootClaimResult)

	// Call DisputeGame.l2BlockNumber() to get L2 block number
	// Function selector: keccak256("l2BlockNumber()") = 0x8b85902b...
	l2BlockData := common.Hex2Bytes("8b85902b")
	l2BlockResult, err := v.l1Client.CallContract(ctx, ethereum.CallMsg{
		To:   &gameAddress,
		Data: l2BlockData,
	}, nil)
	if err != nil {
		return nil, fmt.Errorf("failed to call l2BlockNumber(): %w", err)
	}
	if len(l2BlockResult) != 32 {
		return nil, fmt.Errorf("invalid l2BlockNumber result length: %d", len(l2BlockResult))
	}
	gameData.L2BlockNumber = new(big.Int).SetBytes(l2BlockResult).Uint64()

	// Call DisputeGame.createdAt() to get creation timestamp
	// Function selector: keccak256("createdAt()") = 0xcf09e0d0...
	createdAtData := common.Hex2Bytes("cf09e0d0")
	createdAtResult, err := v.l1Client.CallContract(ctx, ethereum.CallMsg{
		To:   &gameAddress,
		Data: createdAtData,
	}, nil)
	if err != nil {
		return nil, fmt.Errorf("failed to call createdAt(): %w", err)
	}
	if len(createdAtResult) != 32 {
		return nil, fmt.Errorf("invalid createdAt result length: %d", len(createdAtResult))
	}
	gameData.Timestamp = new(big.Int).SetBytes(createdAtResult).Uint64()

	// Find L1 block and tx where this game was created
	// TODO: Search for DisputeGameFactory.DisputeGameCreated event
	// For now, use current block as placeholder
	currentBlock, err := v.l1Client.BlockNumber(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to get current block: %w", err)
	}
	gameData.L1BlockNumber = currentBlock
	gameData.L1TxHash = common.Hash{} // TODO: Find actual creation tx

	return gameData, nil
}

// BatchData represents batch data from L1
type BatchData struct {
	L1BlockNumber uint64
	L1TxHash      common.Hash
	TxIndex       uint
	Data          []byte
	Timestamp     uint64
}

// getBatchDataFromL1 fetches batch data from L1 batcher transaction
func (v *L1DataVerifier) getBatchDataFromL1(
	ctx context.Context,
	batchIndex uint32,
) (*BatchData, error) {
	// TODO: Map batchIndex to L1 block range
	// For now, we need to know the L1 block range to search
	// This could come from:
	// - SystemConfig events
	// - Sequential scanning
	// - Pre-indexed database

	// For MVP, we'll need to be told which L1 block range to search
	// Let's assume we have a method to get this
	fromBlock := uint64(0) // TODO: Get from config or SystemConfig
	toBlock := uint64(1000000) // TODO: Get current L1 block

	// Search for batcher transactions in L1 blocks
	var foundBatch *BatchData
	var batchCounter uint32 = 0

	for blockNum := fromBlock; blockNum <= toBlock; blockNum++ {
		block, err := v.l1Client.BlockByNumber(ctx, big.NewInt(int64(blockNum)))
		if err != nil {
			return nil, fmt.Errorf("failed to get L1 block %d: %w", blockNum, err)
		}

		// Check each transaction
		for txIndex, tx := range block.Transactions() {
			// Must be sent to batchInbox
			if tx.To() == nil || *tx.To() != v.batchInbox {
				continue
			}

			// Must be from batcherAddress
			sender, err := types.Sender(types.LatestSignerForChainID(tx.ChainId()), tx)
			if err != nil {
				continue
			}
			if sender != v.batcherAddress {
				continue
			}

			// Found a batcher transaction
			if batchCounter == batchIndex {
				// This is the batch we're looking for!
				batchData := &BatchData{
					L1BlockNumber: blockNum,
					L1TxHash:      tx.Hash(),
					TxIndex:       uint(txIndex),
				}

				// Get batch data from calldata or blobs
				if len(tx.BlobHashes()) > 0 {
					// EIP-4844 blob transaction
					// TODO: Fetch blob data from beacon chain
					batchData.Data = []byte{} // Placeholder
				} else {
					// Calldata transaction
					batchData.Data = tx.Data()
				}

				// Decode batch to get timestamp
				// TODO: Decode batch properly to extract timestamp
				// For now, use L1 block timestamp as approximation
				batchData.Timestamp = block.Time()

				foundBatch = batchData
				break
			}

			batchCounter++
		}

		if foundBatch != nil {
			break
		}
	}

	if foundBatch == nil {
		return nil, fmt.Errorf("batch index %d not found in L1 blocks %d-%d", batchIndex, fromBlock, toBlock)
	}

	return foundBatch, nil
}

// generateBatchTxProof generates Merkle proof that batch tx is in L1 block
func (v *L1DataVerifier) generateBatchTxProof(
	ctx context.Context,
	l1BlockNumber uint64,
	txIndex uint,
) ([][]byte, error) {
	// Get L1 block
	block, err := v.l1Client.BlockByNumber(ctx, big.NewInt(int64(l1BlockNumber)))
	if err != nil {
		return nil, fmt.Errorf("failed to get L1 block: %w", err)
	}

	// Use merkle proof builder to generate tx proof
	// (We already have this implemented!)
	proofBuilder := NewMerkleProofBuilder()
	proof, err := proofBuilder.BuildTransactionProof(block, txIndex)
	if err != nil {
		return nil, fmt.Errorf("failed to build tx proof: %w", err)
	}

	return proof, nil
}

// MerkleProofBuilder is implemented in merkle_bridge.go

// VerifyBatchAgainstDisputeGame verifies if batch data is consistent with dispute game claim
// This is the main verification function that RAT client will use
func (v *L1DataVerifier) VerifyBatchAgainstDisputeGame(
	ctx context.Context,
	batchIndex uint32,
	disputeGameAddress common.Address,
) (bool, *L1VerificationEvidence, error) {
	evidence, err := v.VerifyL1DataConsistency(ctx, batchIndex, disputeGameAddress)
	if err != nil {
		// Inconsistency found! This is evidence of fraud
		return false, evidence, nil
	}

	// Everything checks out
	return true, evidence, nil
}

// Close closes the L1 client
func (v *L1DataVerifier) Close() {
	if v.l1Client != nil {
		v.l1Client.Close()
	}
}
