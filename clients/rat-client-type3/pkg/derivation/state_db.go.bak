// Close closes the database
func (s *LocalStateDB) Close() error {
	if s.db != nil {
		return s.db.Close()
	}
	return nil
}

// Genesis represents L2 genesis state
type Genesis struct {
	Alloc map[common.Address]GenesisAccount
}

type GenesisAccount struct {
	Balance *big.Int
	Nonce   uint64
	Code    []byte
	Storage map[common.Hash]common.Hash
}

// Checkpoint represents a state checkpoint
// This allows fast bootstrap without syncing from genesis
type Checkpoint struct {
	BlockNumber uint64
	StateRoot   common.Hash
	Timestamp   uint64

	// State snapshot
	Accounts []CheckpointAccount
}

type CheckpointAccount struct {
	Address common.Address
	Balance *big.Int
	Nonce   uint64
	Code    []byte
	Storage map[common.Hash]common.Hash
}

// Example usage:
//
//   // One-time setup (slow)
//   stateDB := NewLocalStateDB("./statedb")
//   stateDB.InitializeFromGenesis(genesis)
//   stateDB.SyncToBlock(ctx, 1000000, fetcher, decoder)
//   // This takes hours/days on first run
//
//   // After setup (fast!)
//   batch := GetBatchFromL1(batchIndex)
//   newRoot := stateDB.ExecuteBatch(ctx, batch, chainConfig)
//   // No L2 RPC needed! ✅
//
// Performance:
//   - Initial sync: 6-24 hours (depending on network)
//   - Storage: 50-200 GB (with pruning)
//   - Batch execution: <1 second (all local)
//   - L2 RPC: NOT NEEDED ✅
