// importSnapshotWithVerification imports snapshot with Merkle proof verification
func (s *LocalStateDB) importSnapshotWithVerification(
	accounts []*CheckpointAccount,
	stateRoot common.Hash,
) error {
	// Create new state
	stateDB, err := state.New(common.Hash{}, state.NewDatabase(s.trieDB), nil)
	if err != nil {
		return fmt.Errorf("failed to create state: %w", err)
	}

	// Import all accounts
	for i, acc := range accounts {
		stateDB.SetBalance(acc.Address, acc.Balance)
		stateDB.SetNonce(acc.Address, acc.Nonce)
		stateDB.SetCode(acc.Address, acc.Code)

		for key, value := range acc.Storage {
			stateDB.SetState(acc.Address, key, value)
		}

		if i%1000 == 0 {
			fmt.Printf("Importing... %d/%d accounts\n", i, len(accounts))
		}
	}

	// Commit and verify root
	computedRoot, err := stateDB.Commit(0, false)
	if err != nil {
		return fmt.Errorf("failed to commit state: %w", err)
	}

	// CRITICAL: Verify computed root matches expected
	if computedRoot != stateRoot {
		return fmt.Errorf(
			"state root mismatch! computed=%s, expected=%s\n"+
				"This means snapshot data is corrupted or L2 RPC lied!",
			computedRoot.Hex(), stateRoot.Hex(),
		)
	}

	fmt.Println("✅ State root verified!")
	return nil
}

// ExecuteBatch executes a batch and updates state
// NO L2 RPC NEEDED - all state is local!
func (s *LocalStateDB) ExecuteBatch(
	ctx context.Context,
	batch *SingularBatch,
	chainConfig *params.ChainConfig,
) (common.Hash, error) {
	// Open state at current root
	stateDB, err := state.New(s.currentRoot, state.NewDatabase(s.trieDB), nil)
	if err != nil {
		return common.Hash{}, fmt.Errorf("failed to open state: %w", err)
	}

	// Create EVM executor
	evmExec := NewEVMExecutor(chainConfig.ChainID)

	// Execute L1 attributes deposit tx
	l1AttrTx, err := evmExec.createL1AttributesDepositTx(batch)
	if err != nil {
		return common.Hash{}, fmt.Errorf("failed to create L1 attr tx: %w", err)
	}

	// Execute transactions
	allTxs := []*types.Transaction{l1AttrTx}
	for _, txBytes := range batch.Transactions {
		tx := new(types.Transaction)
		if err := tx.UnmarshalBinary(txBytes); err != nil {
			return common.Hash{}, fmt.Errorf("failed to unmarshal tx: %w", err)
		}
		allTxs = append(allTxs, tx)
	}

	// Execute all transactions
	var gasUsed uint64
	for i, tx := range allTxs {
		receipt, err := evmExec.applyTransaction(
			stateDB,
			nil, // parent header
			tx,
			&gasUsed,
			evmExec.vmConfig,
		)
		if err != nil {
			return common.Hash{}, fmt.Errorf("failed to execute tx %d: %w", i, err)
		}
		_ = receipt
	}

	// Commit state
	newRoot, err := stateDB.Commit(s.currentBlock+1, true)
	if err != nil {
		return common.Hash{}, fmt.Errorf("failed to commit state: %w", err)
	}

	// Update current state
	s.currentRoot = newRoot
	s.currentBlock++

	return newRoot, nil
}

// GetStateAt returns state DB at specific root
func (s *LocalStateDB) GetStateAt(root common.Hash) (*state.StateDB, error) {
	return state.New(root, state.NewDatabase(s.trieDB), nil)
}

