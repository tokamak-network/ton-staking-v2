// LocalStateDB is a local state database built from L1 batch data
// NO L2 RPC REQUIRED!
//
// Approach:
// 1. Start from genesis or checkpoint
// 2. Execute all L1 batches sequentially
// 3. Build complete state DB
// 4. No L2 RPC dependency!
//
// Trade-offs:
// - Initial sync: Slow (hours to days)
// - Storage: Large (10s-100s GB)
// - After sync: Fast, no L2 RPC needed
// - Fully trustless!
type LocalStateDB struct {
	db     ethdb.Database
	trieDB *trie.Database

	// Current state root
	currentRoot common.Hash

	// Current block number
	currentBlock uint64
}

// NewLocalStateDB creates a new local state DB
func NewLocalStateDB(dataDir string) (*LocalStateDB, error) {
	// Create disk database
	db, err := rawdb.NewLevelDBDatabase(dataDir, 1024, 100, "statedb", false)
	if err != nil {
		return nil, fmt.Errorf("failed to create database: %w", err)
	}

	// Create trie database
	trieDB := trie.NewDatabase(db)

	return &LocalStateDB{
		db:     db,
		trieDB: trieDB,
	}, nil
}

// InitializeFromGenesis initializes state from L2 genesis
func (s *LocalStateDB) InitializeFromGenesis(genesis *Genesis) error {
	// Create genesis state
	stateDB, err := state.New(common.Hash{}, state.NewDatabase(s.trieDB), nil)
	if err != nil {
		return fmt.Errorf("failed to create genesis state: %w", err)
	}

	// Apply genesis allocations
	for addr, alloc := range genesis.Alloc {
		stateDB.SetBalance(addr, alloc.Balance)
		stateDB.SetCode(addr, alloc.Code)
		stateDB.SetNonce(addr, alloc.Nonce)

		for key, value := range alloc.Storage {
			stateDB.SetState(addr, key, value)
		}
	}

	// Commit genesis state
	root, err := stateDB.Commit(0, false)
	if err != nil {
		return fmt.Errorf("failed to commit genesis state: %w", err)
	}

	// Store genesis root
	s.currentRoot = root
	s.currentBlock = 0

	return nil
}

// InitializeFromCheckpoint initializes state from a checkpoint
// This is MUCH faster than from genesis
//
// IMPORTANT: Where does checkpoint data come from?
// Answer: ONE-TIME fetch from L2 RPC or archive node
//
// Process:
// 1. Get finalized state root from L1 (trustless)
// 2. Download state snapshot at that root from L2 (one-time)
// 3. Verify snapshot data against state root (Merkle proofs)
// 4. Import to local DB
// 5. After this: NO L2 RPC needed! ✅
//
// Trade-off:
// - Initial download: Large (10-50 GB), requires L2 RPC
// - After import: Fully local, no L2 dependency
// - Verification: All data verified with Merkle proofs
func (s *LocalStateDB) InitializeFromCheckpoint(
	ctx context.Context,
	finalizedStateRoot common.Hash,
	finalizedBlock uint64,
	l2RPC string, // Only needed for initial download
) error {
	// This is similar to Optimism's "prestate" concept
	// But we verify everything with Merkle proofs

	fmt.Printf("Downloading state snapshot at root %s (block %d)...\n",
		finalizedStateRoot.Hex(), finalizedBlock)
	fmt.Println("This is a ONE-TIME operation and will take 10-30 minutes")
	fmt.Println("After this, L2 RPC is NOT needed!")

	// Connect to L2 RPC (one-time)
	l2Client, err := ethclient.Dial(l2RPC)
	if err != nil {
		return fmt.Errorf("failed to connect to L2: %w", err)
	}
	defer l2Client.Close()

	// Download all accounts and storage at finalized root
	// This uses eth_getProof extensively
	accounts, err := s.downloadStateSnapshot(ctx, l2Client, finalizedStateRoot)
	if err != nil {
		return fmt.Errorf("failed to download snapshot: %w", err)
	}

	fmt.Printf("Downloaded %d accounts\n", len(accounts))

	// Import to local DB with verification
	if err := s.importSnapshotWithVerification(accounts, finalizedStateRoot); err != nil {
		return fmt.Errorf("failed to import snapshot: %w", err)
	}

	// Set current state
	s.currentRoot = finalizedStateRoot
	s.currentBlock = finalizedBlock

	fmt.Println("✅ State DB initialized from finalized checkpoint")
	fmt.Println("✅ L2 RPC no longer needed!")

	return nil
}

