// FinalizeState computes the final state root after all transactions
func (e *EVMExecutor) FinalizeState(stateDB *state.StateDB) (common.Hash, error) {
	// Commit the state changes
	root, err := stateDB.Commit(0, true) // Block number 0, delete empty objects
	if err != nil {
		return common.Hash{}, fmt.Errorf("failed to commit state: %w", err)
	}

	return root, nil
}

// BuildBlockHeader constructs an L2 block header from execution results
func (e *EVMExecutor) BuildBlockHeader(
	batch *SingularBatch,
	parentHeader *types.Header,
	stateRoot common.Hash,
	receipts types.Receipts,
	txs types.Transactions,
	gasUsed uint64,
) (*types.Header, error) {
	// Compute transaction trie root
	txHash := types.DeriveSha(txs, trie.NewStackTrie(nil))

	// Compute receipt trie root
	receiptHash := types.DeriveSha(receipts, trie.NewStackTrie(nil))

	// Build header
	header := &types.Header{
		ParentHash:  batch.ParentHash,
		UncleHash:   types.EmptyUncleHash,
		Coinbase:    common.Address{}, // Optimism uses zero address
		Root:        stateRoot,
		TxHash:      txHash,
		ReceiptHash: receiptHash,
		Bloom:       types.CreateBloom(receipts),
		Difficulty:  big.NewInt(0), // Optimism has no difficulty
		Number:      new(big.Int).Add(parentHeader.Number, big.NewInt(1)),
		GasLimit:    30_000_000, // Optimism default
		GasUsed:     gasUsed,
		Time:        batch.Timestamp,
		Extra:       []byte{},
		MixDigest:   common.Hash{},
		Nonce:       types.BlockNonce{},
	}

	return header, nil
}
