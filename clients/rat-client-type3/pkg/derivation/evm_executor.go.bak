// applyTransaction applies a single transaction to the state
func (e *EVMExecutor) applyTransaction(
	stateDB *state.StateDB,
	header *types.Header,
	tx *types.Transaction,
	usedGas *uint64,
	cfg vm.Config,
) (*types.Receipt, error) {
	// Create EVM context
	blockContext := NewEVMBlockContext(header, nil, nil)
	vmenv := vm.NewEVM(blockContext, vm.TxContext{}, stateDB, e.chainConfig, cfg)

	// Apply transaction
	// TODO: Use core.ApplyTransaction or similar
	_ = vmenv

	return nil, fmt.Errorf("transaction application not implemented")
}

// NewEVMBlockContext creates a block context for EVM
func NewEVMBlockContext(header *types.Header, getHash vm.GetHashFunc, author *common.Address) vm.BlockContext {
	beneficiary := common.Address{}
	if author != nil {
		beneficiary = *author
	} else if header.Coinbase != (common.Address{}) {
		beneficiary = header.Coinbase
	}

	return vm.BlockContext{
		CanTransfer: core.CanTransfer,
		Transfer:    core.Transfer,
		GetHash:     getHash,
		Coinbase:    beneficiary,
		BlockNumber: new(big.Int).Set(header.Number),
		Time:        header.Time,
		Difficulty:  new(big.Int).Set(header.Difficulty),
		GasLimit:    header.GasLimit,
		BaseFee:     header.BaseFee,
	}
}

// createL1AttributesDepositTx creates the L1 attributes deposit transaction
// This is Optimism-specific and contains L1 block info
//
// CRITICAL: This must be executed BEFORE any user transactions in the batch!
// It updates the L1Block predeploy with current L1 context, which affects:
// - Gas fee calculation (L1 data fee)
// - Block context (L1 block number, timestamp accessible to contracts)
func (e *EVMExecutor) createL1AttributesDepositTx(
	batch *SingularBatch,
) (*types.Transaction, error) {
	// L1 Attributes Depositor address (system address)
	// This is a special address that can send deposit transactions
	l1AttributesDepositor := common.HexToAddress("0xdeaddeaddeaddeaddeaddeaddeaddeaddead0001")

	// L1Block predeploy address
	// This is where L1 context is stored on L2
	l1BlockAddress := common.HexToAddress("0x4200000000000000000000000000000000000015")

	// Build calldata: setL1BlockValues(uint64 number, uint64 timestamp, uint256 basefee, bytes32 hash, ...)
	// For MVP, we use simplified version: setL1BlockValuesEcotone()
	//
	// Function selector: keccak256("setL1BlockValuesEcotone()") = 0x440a5e20...
	// Full signature depends on Optimism version
	//
	// Parameters needed:
	// - L1 block number (from batch.EpochNum)
	// - L1 block hash (from batch.EpochHash)
	// - L1 timestamp
	// - L1 basefee
	// - L1 blobBaseFee (for EIP-4844)
	// - Sequence number
	// - Batcher hash
	// - Fee overhead/scalar

	// TODO: Encode proper setL1BlockValues calldata
	// For now, create a placeholder deposit transaction
	calldata := []byte{} // Placeholder

	// Create deposit transaction (type 0x7E)
	// Deposit transactions are special in Optimism:
	// - No signature
	// - No gas price (system transaction)
	// - Included before user transactions
	depositTx := types.NewTx(&types.DepositTx{
		SourceHash: crypto.Keccak256Hash(
			batch.EpochHash.Bytes(),
			common.BigToHash(big.NewInt(int64(batch.EpochNum))).Bytes(),
		),
		From:  l1AttributesDepositor,
		To:    &l1BlockAddress,
		Value: big.NewInt(0),
		Gas:   1000000, // System transaction, gas doesn't matter
		Data:  calldata,
	})

	return depositTx, nil
}

