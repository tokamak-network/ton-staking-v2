{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "hardhat/types"]
  },
  "include": ["./hardhat.config.ts", "./scripts/**/*", "./test/**/*"],
  "exclude": ["node_modules", "dist"]
}

